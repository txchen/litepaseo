{
  "name": "litepaseo",
  "version": "0.3.0",
  "description": "A resource-conscious web console for your Paseo agents",
  "bin": {
    "litepaseo": "dist/server/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "docs/operations.md",
    "docs/markstream-integration-validation.md",
    "docs/performance-plan.md"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && node scripts/compress-web.mjs dist/web && vp pack",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "vue-tsc --noEmit",
    "test:browser": "node tests/browser.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run test:browser",
    "screens": "node tests/screens.mjs",
    "icons": "node scripts/make-icons.mjs",
    "prepack": "npm run build 1>&2"
  },
  "dependencies": {
    "@getpaseo/client": "0.15.3",
    "@getpaseo/protocol": "0.15.3",
    "@hono/node-server": "2.1.6",
    "hono": "4.13.17",
    "markstream-vue": "2.0.25",
    "qrcode": "1.5.4",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "1.5.5",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-vue": "6.0.10",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "typescript": "^5.9.3",
    "vite-plus": "1.5.1",
    "vue": "3.5.45",
    "vue-tsc": "^3.1.0"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/txchen/litepaseo.git"
  },
  "homepage": "https://github.com/txchen/litepaseo#readme",
  "bugs": {
    "url": "https://github.com/txchen/litepaseo/issues"
  },
  "keywords": [
    "paseo",
    "coding-agents",
    "dashboard",
    "self-hosted"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT"
}
